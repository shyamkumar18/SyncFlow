# =============================================================================
# SyncFlow Backend — Environment Configuration
# Copy to .env and fill in your values
# =============================================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local:  mongodb://localhost:27017/syncflow
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/syncflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/syncflow

# JWT — use keys at least 32 characters long
#   Generate: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption — must be 32+ characters
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Google OAuth — required in production
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Production: https://syncflow-api-mem4.onrender.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Gmail Email OAuth — must match Google Cloud Console redirect URI
# Production: https://syncflow-api-mem4.onrender.com/api/email/callback
EMAIL_REDIRECT_URI=http://localhost:5000/api/email/callback

# CORS — comma-separated list of allowed origins
# Development: http://localhost:5173
# Production:  https://syncflow-api-mem4.onrender.com
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# App URL — used for OAuth redirects, links in emails
# Development: http://localhost:5173
# Production:  https://syncflow.pages.dev (Cloudflare Pages)
APP_URL=http://localhost:5173
